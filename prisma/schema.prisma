generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MobDesmob {
  tag                String    @id @db.VarChar(50)
  placa              String    @unique @db.VarChar(20)
  foto_veiculo       String?   @db.Text
  status             String    @db.VarChar(50)
  data_mob           DateTime? @default(now()) @db.Date
  data_desmob        DateTime? @db.Date
  responsavel_desmob String?   @db.VarChar(255)
  observacao_desmob  String?   @db.Text
  modelo             String?   @db.VarChar(100)
  contrato           String?   @db.VarChar(100)
  created_at         DateTime  @default(now()) @db.Timestamp(6)

  // === Manutenção preventiva (FASE 2) ===
  km_limite_preventiva Int  @default(10000)
  km_ultima_preventiva Int?

  documentacoes  DocumentacaoVeiculo[]
  partes_diarias ParteDiaria[]

  @@index([placa])
  @@index([status])
  @@map("mob_desmob")
}

model DocumentacaoVeiculo {
  id         String   @id @default(uuid()) @db.Uuid
  tag        String   @db.VarChar(50)
  documento  String   @db.VarChar(100)
  validade   DateTime @db.Date
  anexo_url  String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(6)

  veiculo MobDesmob @relation(fields: [tag], references: [tag], onDelete: Cascade)

  @@index([tag])
  @@index([validade])
  @@index([tag, validade])
  @@map("documentacao_veiculos")
}

model ParteDiaria {
  id                String   @id @default(uuid()) @db.Uuid
  tag               String   @db.VarChar(50)
  funcionario       String?  @db.VarChar(255)
  funcao            String?  @db.VarChar(100)
  obra              String   @db.VarChar(100)
  obra_programada   String?  @db.VarChar(100)
  data              DateTime @default(now()) @db.Date
  id_relatorio      String?  @db.VarChar(100)
  status            String   @db.VarChar(50)
  lideranca         String?  @db.VarChar(100)
  operador          String?  @db.VarChar(100)
  aderencia         Boolean?
  eficiencia        Decimal? @db.Decimal(5, 2)
  status_assinatura String   @default("PENDENTE") @db.VarChar(50)
  assinatura_dados  Json?
  evidencia_url     String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamp(6)

  // === Parte Diaria (Veiculos Leves) — modelo Omega Service ===
  numero_relatorio  String?  @db.VarChar(50)
  dia_semana        String?  @db.VarChar(20)
  numero_contrato   String?  @db.VarChar(50)
  endereco_obra     String?  @db.Text
  contratante       String?  @db.VarChar(255)
  responsavel       String?  @db.VarChar(255)
  prazo_contratual  Int?
  prazo_decorrido   Int?
  prazo_a_vencer    Int?
  horario_entrada   String?  @db.VarChar(5)
  horario_saida     String?  @db.VarChar(5)
  intervalo_entrada String?  @db.VarChar(5)
  intervalo_saida   String?  @db.VarChar(5)
  // Fluxo: PREENCHENDO | REVISAO | APROVADO (legado)
  status_relatorio    String   @default("PREENCHENDO") @db.VarChar(20)
  // Status Operacional: Operação | Manutenção Corretiva | Manutenção Preventiva | Indisponibilidade | Interdição
  status_operacional  String   @default("Operação") @db.VarChar(50)
  // Fluxo de Aprovação: Em Preenchimento | Finalizado pelo Operador | Revisado pelo Transporte | Aprovado
  status_aprovacao    String   @default("Em Preenchimento") @db.VarChar(50)
  // Pendência geral: checklist sem foto ou atividade com status Pendente
  possui_pendencia    Boolean  @default(false)
  turno               String?  @db.VarChar(20)
  km_inicial          String?  @db.VarChar(50)
  km_final            String?  @db.VarChar(50)
  criado_por          String?  @db.VarChar(255)
  atualizado_por      String?  @db.VarChar(255)
  visualizacoes       Int      @default(0)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamp(6)

  // === Vinculacao com o cadastro de Obras ===
  obra_id             String?  @db.Uuid
  planejador          String?  @db.VarChar(255)

  veiculo MobDesmob @relation(fields: [tag], references: [tag], onDelete: Restrict)
  obra_ref Obra?   @relation(fields: [obra_id], references: [id], onDelete: SetNull)

  mao_obra     ParteDiariaMaoObra[]
  equipamentos ParteDiariaEquipamento[]
  atividades   ParteDiariaAtividade[]
  ocorrencias  ParteDiariaOcorrencia[]
  checklist    ParteDiariaChecklist[]
  comentarios  ParteDiariaComentario[]
  fotos        ParteDiariaFoto[]
  assinaturas  ParteDiariaAssinatura[]
  logs         ParteDiariaLog[]

  @@index([tag])
  @@index([data])
  @@index([status_assinatura])
  @@index([tag, data])
  // Herança do odômetro: última km_final por veículo (data + created_at DESC).
  @@index([tag, data, created_at])
  @@index([numero_relatorio])
  @@index([status_relatorio])
  @@index([status_operacional])
  @@index([status_aprovacao])
  @@map("partes_diarias")
}

model ParteDiariaMaoObra {
  id         String   @id @default(uuid()) @db.Uuid
  parte_id   String   @db.Uuid
  nome       String   @db.VarChar(255)
  matricula  String?  @db.VarChar(50)
  funcao     String?  @db.VarChar(100)
  horario    String?  @db.VarChar(20)
  observacao String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_mao_obra")
}

model ParteDiariaEquipamento {
  id                String   @id @default(uuid()) @db.Uuid
  parte_id          String   @db.Uuid
  tag_patrimonio    String?  @db.VarChar(50)
  descricao         String   @db.VarChar(255)
  horimetro_inicial String?  @db.VarChar(50)
  horimetro_final   String?  @db.VarChar(50)
  status            String?  @db.VarChar(50)
  created_at        DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_equipamentos")
}

model ParteDiariaAtividade {
  id          String   @id @default(uuid()) @db.Uuid
  parte_id    String   @db.Uuid
  descricao   String   @db.Text
  prioridade  String?  @db.VarChar(20)
  local       String?  @db.VarChar(255)
  hora_inicio String?  @db.VarChar(5)
  hora_fim    String?  @db.VarChar(5)
  status      String?  @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_atividades")
}

model ParteDiariaOcorrencia {
  id         String   @id @default(uuid()) @db.Uuid
  parte_id   String   @db.Uuid
  tipo       String?  @db.VarChar(100)
  descricao  String   @db.Text
  hora       String?  @db.VarChar(5)
  gravidade  String?  @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_ocorrencias")
}

model ParteDiariaChecklist {
  id             String   @id @default(uuid()) @db.Uuid
  parte_id       String   @db.Uuid
  item           String   @db.VarChar(255)
  conforme       Boolean? @default(true)
  observacao     String?  @db.Text
  foto_url       String?  @db.Text
  foto_public_id String?  @db.VarChar(255)
  created_at     DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_checklist")
}

model ParteDiariaComentario {
  id         String   @id @default(uuid()) @db.Uuid
  parte_id   String   @db.Uuid
  autor      String?  @db.VarChar(255)
  texto      String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_comentarios")
}

model ParteDiariaFoto {
  id         String   @id @default(uuid()) @db.Uuid
  parte_id   String   @db.Uuid
  url        String   @db.Text
  legenda    String?  @db.VarChar(255)
  public_id  String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_fotos")
}

model ParteDiariaAssinatura {
  id              String    @id @default(uuid()) @db.Uuid
  parte_id        String    @db.Uuid
  etapa           String    @db.VarChar(20)
  nome            String    @db.VarChar(255)
  matricula       String?   @db.VarChar(50)
  assinatura_dado String?   @db.Text
  assinado_em     DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@unique([parte_id, etapa])
  @@index([parte_id])
  @@map("parte_diaria_assinaturas")
}

model ParteDiariaLog {
  id         String   @id @default(uuid()) @db.Uuid
  parte_id   String   @db.Uuid
  acao       String   @db.VarChar(100)
  autor      String?  @db.VarChar(255)
  detalhes   Json?
  created_at DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_logs")
}

model Obra {
  id              String   @id @default(uuid()) @db.Uuid
  nome            String   @db.VarChar(255)
  numero_contrato String?  @db.VarChar(50)
  contratante     String   @default("Vale") @db.VarChar(255)
  gestao          String?  @db.VarChar(255)
  planejador      String?  @db.VarChar(255)
  ativo           Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)

  partes_diarias ParteDiaria[]

  @@index([ativo])
  @@index([nome])
  @@map("obras")
}

enum SetorUsuario {
  MEIO_AMBIENTE
  TRANSPORTE
  GESTAO
}

enum NivelUsuario {
  MASTER
  NORMAL
}

enum TipoUsuario {
  ADMINISTRADOR
  OPERACIONAL
}

model Usuario {
  id         String        @id @default(uuid()) @db.Uuid
  nome       String        @db.VarChar(255)
  matricula  String        @unique @db.VarChar(50)
  contrato   String?       @db.VarChar(100)
  funcao     String?       @db.VarChar(100)
  tipo       TipoUsuario   @default(OPERACIONAL)
  setor      SetorUsuario?
  nivel      NivelUsuario?
  senha_hash     String?       @db.Text
  assinatura_url String?       @db.Text
  created_at     DateTime      @default(now()) @db.Timestamp(6)

  @@index([tipo])
  @@map("usuarios")
}
