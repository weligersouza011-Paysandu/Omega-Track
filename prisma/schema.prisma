generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MobDesmob {
  tag                String    @id @db.VarChar(50)
  placa              String    @unique @db.VarChar(20)
  foto_veiculo       String?   @db.Text
  status             String    @db.VarChar(50)
  data_mob           DateTime? @default(now()) @db.Date
  data_desmob        DateTime? @db.Date
  responsavel_desmob String?   @db.VarChar(255)
  observacao_desmob  String?   @db.Text
  modelo             String?   @db.VarChar(100)
  contrato           String?   @db.VarChar(100)
  created_at         DateTime  @default(now()) @db.Timestamp(6)

  // === Manutenção preventiva (FASE 2) ===
  km_limite_preventiva Int  @default(10000)
  km_ultima_preventiva Int?

  // === Dados técnicos (edição rápida na ficha do veículo) ===
  chassi         String? @db.VarChar(50)
  renavam        String? @db.VarChar(50)
  cor            String? @db.VarChar(50)
  ano_fabricacao Int?
  ano_modelo     Int?
  km_inicial     Int?
  combustivel    String? @db.VarChar(50)

  // === Soft delete (recuperação por 5 dias) ===
  deletado_em  DateTime? @db.Timestamp(6)
  deletado_por String?   @db.VarChar(255)

  documentacoes        DocumentacaoVeiculo[]
  partes_diarias       ParteDiaria[]
  monitoramento_fumaca MonitoramentoFumacaPreta?
  programacoes         ProgramacaoRecurso[]
  manutencoes          ManutencaoRecurso[]

  @@index([placa])
  @@index([status])
  @@index([deletado_em])
  @@map("mob_desmob")
}

model DocumentacaoVeiculo {
  id         String   @id @default(uuid()) @db.Uuid
  tag        String   @db.VarChar(50)
  documento  String   @db.VarChar(100)
  validade   DateTime @db.Date
  anexo_url  String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(6)

  veiculo MobDesmob @relation(fields: [tag], references: [tag], onDelete: Cascade)

  @@index([tag])
  @@index([validade])
  @@index([tag, validade])
  @@map("documentacao_veiculos")
}

model MonitoramentoFumacaPreta {
  id           String   @id @default(uuid()) @db.Uuid
  tag          String   @unique @db.VarChar(50)
  data_medicao DateTime @db.Date
  validade     DateTime @db.Date
  observacao   String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(6)

  veiculo MobDesmob @relation(fields: [tag], references: [tag], onDelete: Cascade)

  @@index([validade])
  @@map("monitoramentos_fumaca_preta")
}

model ParteDiaria {
  id                String   @id @default(uuid()) @db.Uuid
  tag               String   @db.VarChar(50)
  funcionario       String?  @db.VarChar(255)
  funcao            String?  @db.VarChar(100)
  obra              String?  @db.VarChar(100)
  obra_programada   String?  @db.VarChar(100)
  data              DateTime @default(now()) @db.Date
  id_relatorio      String?  @db.VarChar(100)
  status            String   @db.VarChar(50)
  lideranca         String?  @db.VarChar(100)
  operador          String?  @db.VarChar(100)
  aderencia         Boolean?
  eficiencia        Decimal? @db.Decimal(5, 2)
  status_assinatura String   @default("PENDENTE") @db.VarChar(50)
  assinatura_dados  Json?
  evidencia_url     String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamp(6)

  // === Parte Diaria (Veiculos Leves) — modelo Omega Service ===
  numero_relatorio   String?   @db.VarChar(50)
  dia_semana         String?   @db.VarChar(20)
  numero_contrato    String?   @db.VarChar(50)
  endereco_obra      String?   @db.Text
  contratante        String?   @db.VarChar(255)
  responsavel        String?   @db.VarChar(255)
  prazo_contratual   Int?
  prazo_decorrido    Int?
  prazo_a_vencer     Int?
  horario_entrada    String?   @db.VarChar(5)
  horario_saida      String?   @db.VarChar(5)
  intervalo_entrada  String?   @db.VarChar(5)
  intervalo_saida    String?   @db.VarChar(5)
  // Fluxo: PREENCHENDO | REVISAO | APROVADO (legado)
  status_relatorio   String    @default("PREENCHENDO") @db.VarChar(20)
  // Status Operacional: Operação | Manutenção Corretiva | Manutenção Preventiva | Indisponibilidade | Interdição
  status_operacional String    @default("Operação") @db.VarChar(50)
  // Fluxo de Aprovação: Em Preenchimento | Finalizado pelo Operador | Revisado pelo Transporte | Aprovado
  status_aprovacao   String    @default("Em Preenchimento") @db.VarChar(50)
  // Pendência geral: checklist sem foto ou atividade com status Pendente
  possui_pendencia   Boolean   @default(false)
  turno              String?   @db.VarChar(20)
  km_inicial         String?   @db.VarChar(50)
  km_final           String?   @db.VarChar(50)
  criado_por         String?   @db.VarChar(255)
  atualizado_por     String?   @db.VarChar(255)
  // Observacao curta do apontamento rapido (Matriz Calendario).
  observacao_rapida  String?   @db.Text
  visualizacoes      Int       @default(0)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  // Soft delete (recuperacao por 5 dias).
  deletado_em        DateTime? @db.Timestamp(6)
  deletado_por       String?   @db.VarChar(255)

  // === Vinculacao com o cadastro de Obras ===
  obra_id    String? @db.Uuid
  planejador String? @db.VarChar(255)

  veiculo  MobDesmob @relation(fields: [tag], references: [tag], onDelete: Restrict)
  obra_ref Obra?     @relation(fields: [obra_id], references: [id], onDelete: SetNull)

  mao_obra     ParteDiariaMaoObra[]
  equipamentos ParteDiariaEquipamento[]
  atividades   ParteDiariaAtividade[]
  ocorrencias  ParteDiariaOcorrencia[]
  checklist    ParteDiariaChecklist[]
  comentarios  ParteDiariaComentario[]
  fotos        ParteDiariaFoto[]
  assinaturas  ParteDiariaAssinatura[]
  logs         ParteDiariaLog[]

  @@index([tag])
  @@index([data])
  @@index([status_assinatura])
  @@index([tag, data])
  // Herança do odômetro: última km_final por veículo (data + created_at DESC).
  @@index([tag, data, created_at])
  @@index([numero_relatorio])
  @@index([status_relatorio])
  @@index([status_operacional])
  @@index([status_aprovacao])
  @@index([deletado_em])
  @@map("partes_diarias")
}

model ParteDiariaMaoObra {
  id         String   @id @default(uuid()) @db.Uuid
  parte_id   String   @db.Uuid
  nome       String   @db.VarChar(255)
  matricula  String?  @db.VarChar(50)
  funcao     String?  @db.VarChar(100)
  horario    String?  @db.VarChar(20)
  observacao String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_mao_obra")
}

model ParteDiariaEquipamento {
  id                String   @id @default(uuid()) @db.Uuid
  parte_id          String   @db.Uuid
  tag_patrimonio    String?  @db.VarChar(50)
  descricao         String   @db.VarChar(255)
  horimetro_inicial String?  @db.VarChar(50)
  horimetro_final   String?  @db.VarChar(50)
  status            String?  @db.VarChar(50)
  created_at        DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_equipamentos")
}

model ParteDiariaAtividade {
  id          String   @id @default(uuid()) @db.Uuid
  parte_id    String   @db.Uuid
  descricao   String   @db.Text
  prioridade  String?  @db.VarChar(20)
  local       String?  @db.VarChar(255)
  hora_inicio String?  @db.VarChar(5)
  hora_fim    String?  @db.VarChar(5)
  status      String?  @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_atividades")
}

model ParteDiariaOcorrencia {
  id         String   @id @default(uuid()) @db.Uuid
  parte_id   String   @db.Uuid
  tipo       String?  @db.VarChar(100)
  descricao  String   @db.Text
  hora       String?  @db.VarChar(5)
  gravidade  String?  @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_ocorrencias")
}

model ParteDiariaChecklist {
  id             String   @id @default(uuid()) @db.Uuid
  parte_id       String   @db.Uuid
  item           String   @db.VarChar(255)
  conforme       Boolean? @default(true)
  observacao     String?  @db.Text
  foto_url       String?  @db.Text
  foto_public_id String?  @db.VarChar(255)
  created_at     DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_checklist")
}

model ParteDiariaComentario {
  id         String   @id @default(uuid()) @db.Uuid
  parte_id   String   @db.Uuid
  autor      String?  @db.VarChar(255)
  texto      String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_comentarios")
}

model ParteDiariaFoto {
  id         String   @id @default(uuid()) @db.Uuid
  parte_id   String   @db.Uuid
  url        String   @db.Text
  legenda    String?  @db.VarChar(255)
  public_id  String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_fotos")
}

model ParteDiariaAssinatura {
  id              String    @id @default(uuid()) @db.Uuid
  parte_id        String    @db.Uuid
  etapa           String    @db.VarChar(20)
  nome            String    @db.VarChar(255)
  matricula       String?   @db.VarChar(50)
  assinatura_dado String?   @db.Text
  assinado_em     DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@unique([parte_id, etapa])
  @@index([parte_id])
  @@map("parte_diaria_assinaturas")
}

model ParteDiariaLog {
  id         String   @id @default(uuid()) @db.Uuid
  parte_id   String   @db.Uuid
  acao       String   @db.VarChar(100)
  autor      String?  @db.VarChar(255)
  detalhes   Json?
  created_at DateTime @default(now()) @db.Timestamp(6)

  parte ParteDiaria @relation(fields: [parte_id], references: [id], onDelete: Cascade)

  @@index([parte_id])
  @@map("parte_diaria_logs")
}

model Obra {
  id              String   @id @default(uuid()) @db.Uuid
  nome            String   @db.VarChar(255)
  numero_contrato String?  @db.VarChar(50)
  contratante     String   @default("Vale") @db.VarChar(255)
  gestao          String?  @db.VarChar(255)
  planejador      String?  @db.VarChar(255)
  ativo           Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)

  partes_diarias ParteDiaria[]
  programacoes   ProgramacaoRecurso[]

  @@index([ativo])
  @@index([nome])
  @@map("obras")
}

// Uma obra por equipamento em cada dia. A chave unica evita conflitos
// mesmo quando duas pessoas alteram a programacao ao mesmo tempo.
model ProgramacaoRecurso {
  id                   String   @id @default(uuid()) @db.Uuid
  tag                  String   @db.VarChar(50)
  obra_id              String   @db.Uuid
  data                 DateTime @db.Date
  operador_matricula   String?  @db.VarChar(50)
  operador_nome        String?  @db.VarChar(255)
  supervisor_matricula String?  @db.VarChar(50)
  supervisor_nome      String?  @db.VarChar(255)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamp(6)

  equipamento MobDesmob @relation(fields: [tag], references: [tag], onDelete: Cascade)
  obra        Obra      @relation(fields: [obra_id], references: [id], onDelete: Restrict)

  @@unique([tag, data])
  @@index([data])
  @@index([obra_id, data])
  @@map("programacao_recursos")
}

// Cada passagem pela oficina permanece no historico. Somente um registro
// sem data de retorno pode existir por equipamento (indice parcial na migracao).
model ManutencaoRecurso {
  id               String    @id @default(uuid()) @db.Uuid
  tag              String    @db.VarChar(50)
  tipo             String    @db.VarChar(20)
  data_saida       DateTime  @db.Date
  previsao_retorno DateTime  @db.Date
  descricao        String    @db.Text
  data_retorno     DateTime? @db.Date
  registrado_por   String?   @db.VarChar(50)
  retornado_por    String?   @db.VarChar(50)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  equipamento MobDesmob @relation(fields: [tag], references: [tag], onDelete: Cascade)

  @@index([tag, data_saida])
  @@map("manutencao_recursos")
}

// Auditoria de lançamento diário: pendência (veículo x dia sem Parte Diária)
// descartada manualmente por ADM/Transporte para tratar inconsistências de
// frota. A pendência em si é derivada (não persistida): criar a Parte Diária
// do dia dá baixa automática e remove o descarte correspondente.
model PendenciaParteDiariaIgnorada {
  id           String   @id @default(uuid()) @db.Uuid
  tag          String   @db.VarChar(50)
  data         DateTime @db.Date
  motivo       String?  @db.VarChar(255)
  ignorado_por String?  @db.VarChar(255)
  created_at   DateTime @default(now()) @db.Timestamp(6)

  @@unique([tag, data])
  @@index([data])
  @@map("pendencias_parte_diaria_ignoradas")
}

// Auditoria de lançamento diário: override manual do OPERADOR RESPONSÁVEL
// exibido em uma pendência (veículo x dia) — o ADM pode corrigir quem é o
// responsável pela regularização. A pendência segue derivada; quando a Parte
// Diária do dia é lançada, o override é removido automaticamente.
model PendenciaParteDiariaOperador {
  id                 String   @id @default(uuid()) @db.Uuid
  tag                String   @db.VarChar(50)
  data               DateTime @db.Date
  operador_id        String?  @db.Uuid
  operador_nome      String?  @db.VarChar(255)
  operador_matricula String?  @db.VarChar(50)
  atualizado_por     String?  @db.VarChar(255)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([tag, data])
  @@index([data])
  @@map("pendencias_parte_diaria_operador")
}

// Lançamentos do controle de combustível (operacional/ambiental, sem custos).
// O vínculo com a frota é feito por `placa` (e `tag` preenchida no upload via
// cruzamento com MobDesmob); não há FK para preservar o histórico do veículo.
model Abastecimento {
  id                  String   @id @default(uuid()) @db.Uuid
  codigo_transacao    String?  @db.VarChar(100)
  forma_pagamento     String?  @db.VarChar(50)
  data_transacao      DateTime @db.Timestamp(6)
  placa               String   @db.VarChar(20)
  tag                 String?  @db.VarChar(50)
  modelo_veiculo      String?  @db.VarChar(100)
  nome_motorista      String?  @db.VarChar(255)
  tipo_combustivel    String   @db.VarChar(100)
  litros              Float
  hodometro_horimetro Float?
  km_rodados_horas    Float?
  km_por_litro        Float?
  emissao_co2_kg      Float?
  estabelecimento     String?  @db.VarChar(255)
  contrato            String?  @db.VarChar(100)
  mes_referencia      String   @db.VarChar(7)
  created_at          DateTime @default(now()) @db.Timestamp(6)

  @@index([placa])
  @@index([mes_referencia])
  @@index([tipo_combustivel])
  @@map("abastecimentos")
}

// Sub-módulo de Gestão de Resíduos (EcoGestão)
model Residuo {
  id               String   @id @default(uuid())
  data             DateTime
  tipo_residuos    String   // Ex: SUCATA DE PAPEL E PAPELÃO, LIXO COMUM, LODO DE FOSSA SEPTICA, etc.
  numero_mtr_mid   String?  // Número do MTR ou MID
  destinacao       String   // Ex: CMD, EXTERNO
  quantidade_kg_l  Float    // Quantidade em KG ou Litros
  mes_ano          String   // Formato YYYY/MM para agrupamento em gráficos e filtros
  created_at       DateTime @default(now())

  @@index([mes_ano])
  @@index([tipo_residuos])
  @@index([destinacao])
  @@map("residuos")
}


// Parâmetros de preventiva por categoria de veículo (modelo) e contrato.
// Categoria gravada normalizada (MAIÚSCULAS); `contrato` NULL = regra global.
model ParametroPreventiva {
  id                   String   @id @default(uuid()) @db.Uuid
  categoria            String   @db.VarChar(100)
  km_limite_preventiva Int
  contrato             String?  @db.VarChar(100)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([categoria, contrato])
  @@index([categoria])
  @@map("parametros_preventiva")
}

enum SetorUsuario {
  MEIO_AMBIENTE
  TRANSPORTE
  GESTAO
}

enum NivelUsuario {
  MASTER
  NORMAL
}

enum TipoUsuario {
  ADMINISTRADOR
  OPERACIONAL
}

model Usuario {
  id                String        @id @default(uuid()) @db.Uuid
  nome              String        @db.VarChar(255)
  matricula         String        @unique @db.VarChar(50)
  contrato          String?       @db.VarChar(100)
  funcao            String?       @db.VarChar(100)
  tipo              TipoUsuario   @default(OPERACIONAL)
  setor             SetorUsuario?
  nivel             NivelUsuario?
  senha_hash        String?       @db.Text
  assinatura_url    String?       @db.Text
  assinatura_padrao String?       @db.Text
  created_at        DateTime      @default(now()) @db.Timestamp(6)

  logs_atividade LogAtividade[]

  @@index([tipo])
  @@map("usuarios")
}

// Trilha de auditoria global: quem fez o que, em qual modulo e quando.
// nome_usuario/funcao_usuario sao snapshots para preservar o historico mesmo
// se o usuario for excluido (usuario_id vira NULL via onDelete: SetNull).
model LogAtividade {
  id             String   @id @default(uuid()) @db.Uuid
  usuario_id     String?  @db.Uuid
  nome_usuario   String   @db.VarChar(255)
  funcao_usuario String?  @db.VarChar(100)
  acao           String   @db.VarChar(100)
  modulo         String   @db.VarChar(100)
  detalhes       Json?
  ip_address     String?  @db.VarChar(100)
  created_at     DateTime @default(now()) @db.Timestamp(6)

  usuario Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([usuario_id])
  @@index([modulo])
  @@index([acao])
  @@index([modulo, acao])
  @@map("logs_atividade")
}
