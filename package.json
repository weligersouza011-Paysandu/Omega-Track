{
  "name": "omegatrack",
  "version": "1.0.0",
  "description": "Sistema de gestão de transporte, frota e manutenções OmegaTrack",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=./src --watch-path=./package.json src/server.js",
    "build": "npm --prefix frontend install --include=dev && npm --prefix frontend run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "importar:pasta13": "node scripts/importarPasta13.js",
    "import:historico": "node scripts/importarHistoricoLocal.js",
    "import:historico:limpar": "node scripts/importarHistoricoLocal.js --limpar",
    "import:historico:dry": "node scripts/importarHistoricoLocal.js --dry-run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "prisma": "^5.18.0"
  },
  "keywords": [
    "omegatrack",
    "frota",
    "transporte",
    "manutencao",
    "vale"
  ],
  "author": "Omega Track",
  "license": "MIT"
}
